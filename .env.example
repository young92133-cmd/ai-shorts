# Claude 구독 로그인에는 API 키가 필요하지 않습니다.
# 아래 키들은 해당 유료 API 사용을 명시적으로 허용한 경우에만 쓰세요.
ANTHROPIC_API_KEY=   # Factory는 이 키가 있어도 구독 경로에서 사용하지 않음

# 선택 - 리서치 (네이버 개발자센터에서 무료 발급, 없으면 DuckDuckGo만 사용)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=     # 선택: 공개 댓글 후보 자동 수집 (YouTube Data API v3)

# 이미지 생성 (config.yaml images.provider 와 맞춰서 하나만 있어도 됨)
GEMINI_API_KEY=      # 기본값. Nano Banana 2 Lite 장당 약 49원: https://aistudio.google.com/apikey
FAL_KEY=             # 저렴(장당 약 4원): https://fal.ai/dashboard/keys
HF_TOKEN=            # 무료·한도 있음: https://huggingface.co/settings/tokens

# 선택 - 유료 TTS / 이미지 (config.yaml 에서 provider를 바꿔야 사용됨)
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TYPECAST_API_KEY=
